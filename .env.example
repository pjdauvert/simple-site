# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── Netlify Functions ────────────────────────────────────────────────────────
# Blob store name prefix used by ConfigModule and TranslationsModule.
# In local dev this creates a directory-based blob store under .netlify/blobs/.
APP_NAME=simple-site-dev

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Set to "true" to bypass Netlify Identity and use a local mock auth session.
# Required for local dev because @netlify/identity needs a live Netlify site URL.
VITE_AUTH_BYPASS=true

# ── Transloadit (image uploads) ───────────────────────────────────────────────
# Create a free account at https://transloadit.com and get your credentials
# from https://transloadit.com/c/YOUR_ACCOUNT/credentials
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Template ID: create a template at https://transloadit.com/c/YOUR_ACCOUNT/templates
# The template should define how uploaded images are processed (resize, convert, store, etc.)
TRANSLOADIT_TEMPLATE_ID=
