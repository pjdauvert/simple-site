# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── Netlify Functions ────────────────────────────────────────────────────────
# Blob store name prefix used by ConfigModule and TranslationsModule.
# In local dev this creates a directory-based blob store under .netlify/blobs/.
APP_NAME=simple-site-dev

# FEATURE FLAGS

# Media library. "true" enables the /manage/media
# page (the client reads it at runtime via /api/features) AND the /api/media*
# endpoints incl. the upload-signature; any other value disables both. Read at
# request time, so flipping it needs no rebuild — just a redeploy / dev restart.
FEATURE_MEDIA=false

# Team. "true" enables the /manage/team page, the public /team pages (the client
# reads it at runtime via /api/features) AND the /api/team endpoint; any other
# value disables all of them (404). Read at request time, so flipping it needs
# no rebuild — just a redeploy / dev restart.
FEATURE_TEAM=false

# Contact. "true" enables the /manage/contact page, the public /contact page
# (the client reads it at runtime via /api/features) AND the /api/contact
# endpoint; any other value disables all of them (404). Read at request time,
# so flipping it needs no rebuild — just a redeploy / dev restart. Requires the
# Resend variables below.
FEATURE_CONTACT=false

# ── ImageKit (media management) ──────────────────────────────────────────────
# Credentials from your ImageKit dashboard (Developer options → API keys).
# The private key is used server-side only (signs V2 upload tokens, authenticates
# the Management API) and must never reach the browser.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional base folder all media is scoped under (created on first upload).
# Leave blank or "/" to use the ImageKit account root. Example: /simple-site
IMAGEKIT_ROOT_DIR=/simple-site

# ── Resend (contact form) ────────────────────────────────────────────────────
# API key from your Resend dashboard (API Keys). Server-side only — signs the
# /api/contact relay and must never reach the browser.
RESEND_API_KEY=
# Sender the contact notification is sent AS. Must be on a domain verified in
# Resend (the visitor's address goes in reply-to). Example: Site <contact@your-domain.com>
CONTACT_FROM_EMAIL=
# Inbox the contact messages are delivered to.
CONTACT_TO_EMAIL=


# DEV ENV

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Set to "true" to bypass Netlify Identity and use a local mock auth session.
# Required for local dev because @netlify/identity needs a live Netlify site URL.
VITE_AUTH_BYPASS=true
