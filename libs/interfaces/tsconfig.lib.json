{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.interfaces.tsbuildinfo",
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "../../dist/interfaces",
    "rootDir": "src",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  // Tests never reach the published declarations; `tsconfig.spec.json`
  // typechecks them, Vitest runs them.
  "exclude": ["src/**/*.test.ts"]
}
